generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String @id @default(uuid(7)) @db.Uuid
  reference   String   @unique
  name        String
  description String
  price       Decimal  @db.Decimal(12, 2)
  currency    String
  stock       Int
  reviews     Review[]
  @@map("products")
}

model Review {
  id          String @id @default(uuid(7)) @db.Uuid
  notation    Int
  date        DateTime
  comment     String
  productId   String @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  authorId    String @db.Uuid
  author      Author   @relation(fields: [authorId], references: [id])

  @@index([productId])
  @@index([authorId])
  @@map("reviews")
}

model Author {
  id          String @id @default(uuid(7)) @db.Uuid
  firstName   String
  lastName    String
  type        String
  reviews     Review[]
  @@map("authors")
}